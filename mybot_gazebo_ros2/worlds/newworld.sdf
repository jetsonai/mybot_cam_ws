<?xml version="1.0" ?>
<!-- newworld.world 에서 convert_world 로 변환한 Gazebo Sim(Fortress) 월드 -->
<sdf version="1.7">
  <world name="default">

    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>
    <!-- gpu_lidar 용. WSL2 에서는 ogre2 가 죽는 경우가 많아 ogre 사용 -->
    <plugin filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-imu-system"
            name="ignition::gazebo::systems::Imu"/>

    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>false</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface><friction><ode><mu>100</mu><mu2>50</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="Untitled">
      <static>true</static>
      <link name="Wall_0">
        <pose>-1.40353 -0.277567 0 0 0 -1.5708</pose>
        <collision name="collision_0"><pose>0 0 1.25 0 -0 0</pose><geometry><box><size>4 0.15 2.5</size></box></geometry></collision>
        <visual name="visual_0"><pose>0 0 1.25 0 -0 0</pose><geometry><box><size>4 0.15 2.5</size></box></geometry><material><ambient>0.62 0.32 0.22 1</ambient><diffuse>0.62 0.32 0.22 1</diffuse></material></visual>
      </link>
      <link name="Wall_1">
        <pose>1.77147 -2.20257 0 0 -0 0</pose>
        <collision name="collision_0"><pose>0 0 1.25 0 -0 0</pose><geometry><box><size>6.5 0.15 2.5</size></box></geometry></collision>
        <visual name="visual_0"><pose>0 0 1.25 0 -0 0</pose><geometry><box><size>6.5 0.15 2.5</size></box></geometry><material><ambient>0.62 0.32 0.22 1</ambient><diffuse>0.62 0.32 0.22 1</diffuse></material></visual>
      </link>
      <link name="Wall_2">
        <pose>4.94646 -0.277567 0 0 -0 1.5708</pose>
        <collision name="collision_0"><pose>0 0 1.25 0 -0 0</pose><geometry><box><size>4 0.15 2.5</size></box></geometry></collision>
        <visual name="visual_0"><pose>0 0 1.25 0 -0 0</pose><geometry><box><size>4 0.15 2.5</size></box></geometry><material><ambient>0.62 0.32 0.22 1</ambient><diffuse>0.62 0.32 0.22 1</diffuse></material></visual>
      </link>
      <link name="Wall_3">
        <pose>1.77147 1.64743 0 0 -0 3.14159</pose>
        <collision name="collision_0"><pose>0 0 1.25 0 -0 0</pose><geometry><box><size>6.5 0.15 2.5</size></box></geometry></collision>
        <visual name="visual_0"><pose>0 0 1.25 0 -0 0</pose><geometry><box><size>6.5 0.15 2.5</size></box></geometry><material><ambient>0.62 0.32 0.22 1</ambient><diffuse>0.62 0.32 0.22 1</diffuse></material></visual>
      </link>
      <link name="Wall_5">
        <pose>1.67647 1.06743 0 0 0 -1.5708</pose>
        <collision name="collision_0"><pose>0 0 1.25 0 -0 0</pose><geometry><box><size>1.25 0.15 2.5</size></box></geometry></collision>
        <visual name="visual_0"><pose>0 0 1.25 0 -0 0</pose><geometry><box><size>1.25 0.15 2.5</size></box></geometry><material><ambient>0.62 0.32 0.22 1</ambient><diffuse>0.62 0.32 0.22 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
